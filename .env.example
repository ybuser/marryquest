# Database
DATABASE_URL="postgresql://USER:PASSWORD@POOLED_HOST/DATABASE?sslmode=require&connect_timeout=15"
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require&connect_timeout=15"

# NextAuth
# Every replace-with-* value is an invalid public sentinel; replace it before use.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-unique-random-secret"

# Single owner
OWNER_LOGIN_ID="replace-with-owner-login-id"
OWNER_EMAIL="replace-with-owner-email"
OWNER_NAME="MarryQuest Owner"
OWNER_PASSWORD_HASH="replace-with-generated-scrypt-hash"

# Application security
QUIZ_BADGE_SECRET="replace-with-a-different-random-secret"
ADMIN_PASSPHRASE="replace-with-another-random-secret"

# Build
SKIP_PRISMA_GENERATION="false"

# Legacy timeline upload only — removed in Recovery-03.
# Do not reuse recovered Supabase secrets. Production will not receive these legacy values.
# Timeline upload may remain unavailable until Recovery-03 replaces this path with R2.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="timeline"
