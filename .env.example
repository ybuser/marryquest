# Database
# For local or approved migration environments, DIRECT_URL is the actual direct endpoint.
# Netlify is the exception: duplicate its pooled DATABASE_URL as DIRECT_URL; see docs/ops/netlify-staging.md.
DATABASE_URL="postgresql://USER:PASSWORD@POOLED_HOST/DATABASE?sslmode=require&connect_timeout=15"
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require&connect_timeout=15"

# NextAuth
# Every replace-with-* value is an invalid public sentinel; replace it before use.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-unique-random-secret"

# Single owner
OWNER_LOGIN_ID="replace-with-owner-login-id"
OWNER_EMAIL="replace-with-owner-email@example.com"
OWNER_NAME="MarryQuest Owner"
OWNER_PASSWORD_HASH="replace-with-generated-scrypt-hash"

# Application security
QUIZ_BADGE_SECRET="replace-with-a-different-random-secret"
ADMIN_PASSPHRASE="replace-with-another-random-secret"

# Build
SKIP_PRISMA_GENERATION="false"

# R2 storage
# Public examples only; keep actual credentials in an approved server-only secret store.
# Preview contexts must use fail-closed placeholders; see docs/ops/netlify-staging.md.
R2_ACCOUNT_ID="replace-with-r2-account-id"
R2_ACCESS_KEY_ID="replace-with-r2-access-key-id"
R2_SECRET_ACCESS_KEY="replace-with-r2-secret-access-key"
R2_ENDPOINT="https://ACCOUNT_ID.r2.cloudflarestorage.com"
R2_UPLOAD_BUCKET="marryquest-upload-staging"
R2_PUBLIC_BUCKET="marryquest-assets-staging"
R2_PUBLIC_BASE_URL="https://assets-staging.marryquest.shimyunbo.com"
