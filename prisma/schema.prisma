generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InvitationStatus {
  draft
  published
  private
}

enum TemplateKey {
  mono
  minimal
  editorial
  film
}

enum Attendance {
  yes
  no
  maybe
}

enum Badge {
  none
  quizPerfect
  timelinePerfect
  foodWinner
}

model User {
  id          String        @id @default(cuid())
  email       String        @unique
  name        String?
  createdAt   DateTime      @default(now())
  invitations Invitation[]
  accounts    Account[]
  sessions    Session[]
}

model Invitation {
  id            String           @id @default(cuid())
  userId        String
  slug          String           @unique
  status        InvitationStatus @default(draft)
  templateKey   TemplateKey      @default(mono)
  title         String
  groomName     String?
  brideName     String?
  dateTime      DateTime?
  venueName     String?
  address       String?
  lat           Float?
  lng           Float?
  accountGroom  String?
  accountBride  String?
  contactGroom  String?
  contactBride  String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sectionConfigs  SectionConfig[]
  galleryPhotos   GalleryPhoto[]
  rsvpResponses   RSVPResponse[]
  guestbookEntries GuestbookEntry[]
}

model SectionConfig {
  id           String     @id @default(cuid())
  invitationId String
  key          String
  enabled      Boolean    @default(true)
  order        Int

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
}

model GalleryPhoto {
  id           String     @id @default(cuid())
  invitationId String
  url          String
  caption      String?
  order        Int

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
}

model RSVPResponse {
  id           String     @id @default(cuid())
  invitationId String
  attendance   Attendance
  guestsCount  Int?
  kidsCount    Int?
  allergiesText String?
  createdAt    DateTime   @default(now())
  ipHash       String?

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
}

model GuestbookEntry {
  id           String   @id @default(cuid())
  invitationId String
  nickname     String
  message      String
  badge        Badge    @default(none)
  hidden       Boolean  @default(false)
  createdAt    DateTime @default(now())

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
